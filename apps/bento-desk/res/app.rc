// Resources of bento-desk.exe: icon, manifest and version information.
// Numeric constants are used so that no SDK header is needed.

1 ICON "../../../assets/bento.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Bento Desk"
            VALUE "FileDescription", "Bento Desk"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "bento-desk"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "bento-desk.exe"
            VALUE "ProductName", "Bento Desk"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
