}

component CondEditor inherits HorizontalLayout {
    in property <int> index;
    in property <int> field;
    in property <int> op;
    in property <string> value;
    in property <int> kind;
    in property <int> date-field;
    in property <int> days;
    spacing: 8px;
    ComboBox {
        width: 150px;
        model: [@tr("Name"), @tr("Extension"), @tr("Type"), @tr("Shortcut target"), @tr("Date")];
        current-index: root.field;
        selected => {
            Rules.cond-set(root.index, "field", self.current-index, "");
        }
    }
    if root.field == 0 || root.field == 3: ComboBox {
        width: 150px;
        model: [@tr("contains"), @tr("starts with"), @tr("is")];
        current-index: root.op;
        selected => {
            Rules.cond-set(root.index, "op", self.current-index, "");
        }
    }
    if root.field == 0 || root.field == 1 || root.field == 3: LineEdit {
        horizontal-stretch: 1;
        min-width: 160px;
        text: root.value;
        placeholder-text: root.field == 1 ? @tr("pdf, docx, xlsx") : "";
        edited(t) => {
            Rules.cond-set(root.index, "value", 0, t);
        }
    }
    if root.field == 2: ComboBox {
        width: 180px;
        model: [@tr("Shortcut"), @tr("Folder"), @tr("File"), @tr("Internet link"), @tr("System item")];
        current-index: root.kind;
        selected => {
            Rules.cond-set(root.index, "kind", self.current-index, "");
        }
    }
    if root.field == 4: ComboBox {
        width: 150px;
        model: [@tr("modified"), @tr("created")];
        current-index: root.date-field;
        selected => {
            Rules.cond-set(root.index, "date", self.current-index, "");
        }
    }
    if root.field == 4: ComboBox {
        width: 170px;
        model: [@tr("less than"), @tr("more than")];
        current-index: root.op;
        selected => {
            Rules.cond-set(root.index, "op", self.current-index, "");
        }
    }
    if root.field == 4: SpinBox {
        width: 110px;
        minimum: 0;
        maximum: 3650;
        value: root.days;
        edited(v) => {
            Rules.cond-set(root.index, "days", v, "");
        }
    }
    if root.field == 4: Text {
        text: @tr("days ago");
        color: Theme.text2;
        vertical-alignment: center;
    }
    if root.field == 2: Rectangle {
        horizontal-stretch: 1;
    }
    if root.field == 4: Rectangle {
        horizontal-stretch: 1;
    }
    Button {
        text: @tr("Remove");
        clicked => {
            Rules.cond-remove(root.index);
        }
    }
}

export component RulesPage inherits ScrollPage {
    PageHeader {
        reset-page: 6;
        title: @tr("Sorting rules");
        subtitle: @tr("New desktop icons go to the Bento of the first matching rule. Rules are checked from top to bottom.");
    }

    Card {
        icon: "\u{E8CB}";
        title: @tr("Apply rules to new icons");
        Switch {
            checked <=> Cfg.rules-auto-apply;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E72C}";
        title: @tr("Sort the whole desktop now");
        description: @tr("Applies the rules to every icon of the desktop, including icons already in Bentos.");
        Button {
            text: @tr("Sort now");
            clicked => {
                Rules.sort-now();
            }
        }
    }

    SectionLabel {
        text: @tr("Rules");
    }

    if Rules.rules.length == 0: Panel {
        Text {
            text: @tr("No rule. Add one to file new icons automatically.");
            color: Theme.text2;
            wrap: word-wrap;
        }
    }

    for r[i] in Rules.rules: Card {
        icon: "\u{E71C}";
        title: r.name == "" ? @tr("(unnamed rule)") : r.name;
        description: r.summary + "  →  " + r.target;
        clickable: true;
        selected: Rules.selected == i;
        clicked => {
            Rules.select(i);
        }
        Switch {
            checked: r.enabled;
            toggled => {
                Rules.set-enabled(i, self.checked);
            }
        }
    }

    HorizontalLayout {
        padding-top: 8px;
        spacing: 8px;
        alignment: start;
        Button {
            text: @tr("Add a rule");
            primary: true;
            clicked => {
                Rules.add();
            }
        }
        Button {
            text: @tr("Move up");
            enabled: Rules.selected > 0;
            clicked => {
                Rules.move(-1);
            }
        }
        Button {
            text: @tr("Move down");
            enabled: Rules.selected >= 0 && Rules.selected < Rules.rules.length - 1;
            clicked => {
                Rules.move(1);
            }
        }
        Button {
            text: @tr("Delete");
            enabled: Rules.selected >= 0;
            clicked => {
                Rules.remove();
            }
        }
    }

    if Rules.selected >= 0: VerticalLayout {
        spacing: 4px;
        SectionLabel {
            text: @tr("Edit the rule");
        }

        Card {
            title: @tr("Name");
            LineEdit {
                width: 280px;
                text <=> Rules.name;
                edited => {
                    Rules.edited();
                }
            }
        }

        Card {
            title: @tr("Destination Bento");
            ComboBox {
                width: 280px;
                model: Desk.fence-titles;
                current-index <=> Rules.target;
                selected => {
                    Rules.edited();
                }
            }
        }

        Card {
            title: @tr("Conditions");
            ComboBox {
                width: 280px;
                model: [@tr("All conditions must match"), @tr("Any condition can match")];
                current-index <=> Rules.match-mode;
                selected => {
                    Rules.edited();
                }
            }
        }

        Panel {
            for c[i] in Rules.conditions: CondEditor {
                index: i;
                field: c.field;
                op: c.op;
                value: c.value;
                kind: c.kind;
                date-field: c.date-field;
                days: c.days;
            }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Add a condition");
                    clicked => {
                        Rules.cond-add();
                    }
                }
            }
        }

        Card {
            icon: "\u{E9D9}";
            title: @tr("Test the rule");
            description: Rules.test-status;
            Button {
                text: @tr("Test");
                clicked => {
                    Rules.test();
                }
            }
        }

        if Rules.test-results.length > 0: Panel {
            for t in Rules.test-results: Text {
                text: t;
                color: Theme.text;
                overflow: elide;
            }
        }
    }
}

export component PortalsPage inherits ScrollPage {
    PageHeader {
        reset-page: 7;
        title: @tr("Folder portals");
        subtitle: @tr("A portal shows the content of any folder inside a Bento. Create one from the tray icon menu or from a Bento menu.");
    }

    Card {
        icon: "\u{E8FD}";
        title: @tr("Default view");
        ComboBox {
            width: 200px;
            model: [@tr("Icons"), @tr("List")];
            current-index <=> Cfg.portal-view;
            selected => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E8B7}";
        title: @tr("Hide the folder icon in the title");
        Switch {
            checked <=> Cfg.portal-hide-title-icon;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E890}";
        title: @tr("Show hidden files");
        Switch {
            checked <=> Cfg.portal-show-hidden;
            toggled => {
                Cfg.changed();
            }
        }
    }
}

export component PeekPage inherits ScrollPage {
    PageHeader {
        reset-page: 8;
        title: @tr("Peek");
        subtitle: @tr("Shows your Bentos above all windows. Click an item to open it, Escape to close.");
    }

    Card {
        icon: "\u{E765}";
        title: @tr("Peek shortcut");
        description: @tr("Win+Space switches the keyboard layout on Windows, so another combination is used by default.");
        HotkeyField {
            value <=> Cfg.hk-peek;
        }
    }

    Card {
        icon: "\u{E706}";
        title: @tr("Dim the windows behind");
        Slider {
            width: 240px;
            minimum: 0;
            maximum: 80;
            value <=> Cfg.peek-dim;
            changed => {
                Cfg.changed();
            }
        }
        SliderValue {
            text: round(Cfg.peek-dim) + " %";
        }
    }
}

export component SnapshotsPage inherits ScrollPage {
    PageHeader {
        reset-page: 9;
        title: @tr("Layouts and snapshots");
        subtitle: @tr("Bento Desk keeps one layout per display configuration. A snapshot saves the current layout to restore it later.");
    }

    Card {
        icon: "\u{E7F4}";
        title: @tr("Restore the layout of each display configuration");
        description: @tr("When monitors are plugged or unplugged, Bentos go back to where they were for that configuration.");
        Switch {
            checked <=> Cfg.layouts-auto-restore;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E7F4}";
        title: @tr("Current layout");
        description: Desk.layout-name;
    }

    SectionLabel {
        text: @tr("Snapshots");
    }

    Card {
        icon: "\u{E74E}";
        title: @tr("Save a snapshot");
        LineEdit {
            width: 220px;
            placeholder-text: @tr("Name (optional)");
            text <=> Snaps.new-name;
        }
        Button {
            text: @tr("Save");
            primary: true;
            clicked => {
                Snaps.save();
            }
        }
    }

    if Snaps.items.length == 0: Panel {
        Text {
            text: @tr("No snapshot yet.");
            color: Theme.text2;
        }
    }

    for s[i] in Snaps.items: Card {
        icon: "\u{E81C}";
        title: s.name;
        description: s.date + "  ·  " + s.fences;
        Button {
            text: @tr("Restore");
            clicked => {
                Snaps.restore(i);
            }
        }
        Button {
            text: @tr("Delete");
            clicked => {
                Snaps.delete(i);
            }
        }
    }

    if Snaps.monitors.length > 1: VerticalLayout {
        spacing: 4px;
        SectionLabel {
            text: @tr("Monitors");
        }

        Card {
            icon: "\u{E8AB}";
            title: @tr("Swap the Bentos of two monitors");
            ComboBox {
                width: 200px;
                model: Snaps.monitors;
                current-index <=> Snaps.swap-a;
            }
            ComboBox {
                width: 200px;
                model: Snaps.monitors;
                current-index <=> Snaps.swap-b;
            }
            Button {
                text: @tr("Swap");
                enabled: Snaps.swap-a != Snaps.swap-b;
                clicked => {
                    Snaps.swap();
                }
            }
        }
    }
}

export component GeneralPage inherits ScrollPage {
    PageHeader {
        reset-page: 10;
        title: @tr("General");
    }

    Card {
        icon: "\u{E774}";
        title: @tr("Language");
        ComboBox {
            width: 200px;
            model: [@tr("Windows language"), "Français", "English"];
            current-index <=> Cfg.language;
            selected => {
                Cfg.changed();
                Cfg.language-changed();
            }
        }
    }

    Card {
        icon: "\u{E7E8}";
        title: @tr("Start with Windows");
        description: App.portable ? @tr("Not available in portable mode.") : "";
        Switch {
            enabled: !App.portable;
            checked <=> Cfg.start-with-windows;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E7C4}";
        title: @tr("Show in the taskbar");
        description: @tr("Adds a taskbar button, useful with some docks and taskbar tools.");
        Switch {
            checked <=> Cfg.show-in-taskbar;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E8B0}";
        title: @tr("Desktop gestures");
        description: @tr("Draw a Bento with the right button, scroll Bentos with the wheel. Uses a mouse hook only while the desktop is in the foreground.");
        Switch {
            checked <=> Cfg.desktop-gestures;
            toggled => {
                Cfg.changed();
            }
        }
    }

    SectionLabel {
        text: @tr("Game mode");
    }

    Card {
        icon: "\u{E7FC}";
        title: @tr("Pause during full-screen applications");
        description: @tr("Stops the mouse hook and every background task while a game or a video is full screen.");
        Switch {
            checked <=> Cfg.pause-on-fullscreen;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Panel {
        Text {
            text: @tr("Pause while these programs are in the foreground (one executable name per line):");
            color: Theme.text;
            wrap: word-wrap;
        }
        TextEdit {
            height: 130px;
            text <=> Cfg.exclusions;
            edited => {
                Cfg.changed();
            }
        }
    }
}

export component BackupPage inherits ScrollPage {
    PageHeader {
        title: @tr("Backup");
        subtitle: @tr("One file holds the settings, the Bentos of every layout and the snapshots.");
    }

    Card {
        icon: "\u{EDE1}";
        title: @tr("Export");
        description: @tr("Save everything to a file.");
        Button {
            text: @tr("Export...");
            clicked => {
                Sys.export();
            }
        }
    }

    Card {
        icon: "\u{E8B5}";
        title: @tr("Import");
        description: @tr("Replace the current settings and Bentos with a file. The desktop is rebuilt at once.");
        Button {
            text: @tr("Import...");
            clicked => {
                Sys.import();
            }
        }
    }

    Card {
        icon: "\u{E8B7}";
        title: @tr("Data folder");
        description: App.data-dir;
        Button {
            text: @tr("Open");
            clicked => {
                Sys.open-data();
            }
        }
    }
}

export component TroubleshootingPage inherits ScrollPage {
    PageHeader {
        reset-page: 12;
        title: @tr("Troubleshooting");
    }

    Card {
        icon: "\u{E7BA}";
        title: @tr("Recover lost icons");
        description: @tr("Brings every hidden or off-screen icon back to the visible desktop.");
        Button {
            text: @tr("Recover");
            clicked => {
                Sys.recover-icons();
            }
        }
    }

    Card {
        icon: "\u{E777}";
        title: @tr("Restore Explorer options");
        description: @tr("Puts back \"Auto arrange icons\" and \"Align icons to grid\" as they were before Bento Desk.");
        Button {
            text: @tr("Restore");
            clicked => {
                Sys.restore-explorer();
            }
        }
    }

    Card {
        icon: "\u{E9F9}";
        title: @tr("Log level");
        ComboBox {
            width: 160px;
            model: [@tr("Errors"), @tr("Warnings"), @tr("Information"), @tr("Debug"), @tr("Trace")];
            current-index <=> Cfg.log-level;
            selected => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E8A5}";
        title: @tr("Logs");
        Button {
            text: @tr("Open the folder");
            clicked => {
                Sys.open-logs();
            }
        }
    }

    Card {
        icon: "\u{EBE8}";
        title: @tr("Debug package");
        description: @tr("Collects logs, settings and layout in a folder, to attach to a bug report. Nothing is sent.");
        Button {
            text: @tr("Create");
            clicked => {
                Sys.debug-package();
            }
        }
    }

    SectionLabel {
        text: @tr("Resident app");
    }

    Card {
        icon: "\u{E7E8}";
        title: Desk.daemon-running ? @tr("Bento Desk is running") : @tr("Bento Desk is not running");
        if Desk.daemon-running: Button {
            text: @tr("Quit Bento Desk");
            clicked => {
                Sys.quit-daemon();
            }
        }
        if !Desk.daemon-running: Button {
            text: @tr("Start");
            primary: true;
            clicked => {
                Sys.start-daemon();
            }
        }
    }
}

export component AboutPage inherits ScrollPage {
    PageHeader {
        title: @tr("About");
    }

    Panel {
        HorizontalLayout {
            spacing: 20px;
            Image {
                source: @image-url("../../../assets/bento.png");
                width: 56px;
                height: 56px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                Text {
                    text: "Bento Desk " + App.version;
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Free and open-source software under the MIT license.");
                    color: Theme.text2;
                }
            }
        }
    }

    Card {
        icon: "\u{E72E}";
        title: @tr("No injection, no network");
        description: @tr("Bento Desk loads no code into other processes, sends no data and needs no account. It uses only documented Windows APIs.");
    }

    Card {
        icon: "\u{E71B}";
        title: @tr("Source code");
        description: "github.com/HugoErb/Bento-Desk";
        Button {
            text: @tr("Open");
            clicked => {
                App.open-url("https://github.com/HugoErb/Bento-Desk");
            }
        }
    }

    SectionLabel {
        text: @tr("Made with Slint");
    }

    Panel {
        AboutSlint {
            preferred-height: 180px;
        }
    }
}
