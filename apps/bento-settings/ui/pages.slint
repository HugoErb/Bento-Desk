// Pages of the settings window. Each page reads and writes the globals and
// reports changes through their callbacks.

import { Button, Switch, ComboBox, Slider, SpinBox, LineEdit, TextEdit, AboutSlint } from "std-widgets.slint";
import { Theme, App, Cfg, Desk, Style, Rules, Snaps, Sys } from "globals.slint";
import { Glyph, PageHeader, SectionLabel, Card, Panel, HotkeyField, FencePreview, FontPicker, ScrollPage, ColorPicker } from "widgets.slint";

/// Value shown next to a slider.
component SliderValue inherits Text {
    width: 48px;
    color: Theme.text2;
    horizontal-alignment: right;
    vertical-alignment: center;
}

component StatusDot inherits Rectangle {
    in property <bool> on;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: on ? Theme.ok : Theme.warn;
}

export component HomePage inherits ScrollPage {
    PageHeader {
        title: @tr("Home");
        subtitle: @tr("Organize your desktop icons into Bentos, without touching any other process.");
    }

    Panel {
        HorizontalLayout {
            spacing: 20px;
            Image {
                source: @image-url("../../../assets/bento.png");
                width: 64px;
                height: 64px;
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: "Bento Desk";
                    font-size: 22px;
                    font-weight: 600;
                    color: Theme.text;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    StatusDot {
                        on: Desk.daemon-running;
                        y: 4px;
                    }
                    Text {
                        text: Desk.daemon-running ? @tr("Running") : @tr("Not running");
                        color: Theme.text2;
                    }
                    Text {
                        text: "·";
                        color: Theme.text2;
                    }
                    Text {
                        text: @tr("{} Bentos on {} pages", Desk.fences.length, Desk.page-count);
                        color: Theme.text2;
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                if !Desk.daemon-running: Button {
                    text: @tr("Start Bento Desk");
                    primary: true;
                    clicked => {
                        Sys.start-daemon();
                    }
                }
            }
        }
    }

    SectionLabel {
        text: @tr("Get started");
    }

    Card {
        icon: "\u{E8B0}";
        title: @tr("Create a Bento");
        description: @tr("Hold the right mouse button on an empty desktop area and drag a rectangle, or use the tray icon menu.");
    }

    Card {
        icon: "\u{E7C2}";
        title: @tr("Move icons");
        description: @tr("Drag desktop icons into a Bento. Icons stay real desktop icons: open, rename and right-click work as usual.");
    }

    Card {
        icon: "\u{E70E}";
        title: @tr("Roll up a Bento");
        description: @tr("Double-click the title bar to keep only the title visible.");
    }

    Card {
        icon: "\u{E7B3}";
        title: @tr("Peek");
        description: @tr("Press the Peek shortcut to show your Bentos above all windows.");
        Text {
            text: Cfg.hk-peek == "" ? @tr("None") : Cfg.hk-peek;
            color: Theme.text2;
            vertical-alignment: center;
        }
    }

    SectionLabel {
        text: @tr("Shortcuts");
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button {
            text: @tr("Manage Bentos");
            clicked => {
                App.page = 1;
            }
        }
        Button {
            text: @tr("Appearance");
            clicked => {
                App.page = 2;
            }
        }
        Button {
            text: @tr("Sorting rules");
            clicked => {
                App.page = 6;
            }
        }
    }
}

export component FencesPage inherits ScrollPage {
    PageHeader {
        title: @tr("Bentos");
        subtitle: @tr("Bentos of the current display layout. Click one to edit it.");
    }

    if Desk.fences.length == 0: Panel {
        Text {
            text: @tr("No Bento yet. Hold the right mouse button on the desktop and drag to create one.");
            color: Theme.text2;
            wrap: word-wrap;
        }
    }

    for f[i] in Desk.fences: Card {
        icon: f.portal ? "\u{E838}" : "\u{ECA5}";
        title: f.title == "" ? @tr("(untitled)") : f.title;
        description: f.detail;
        clickable: true;
        selected: Desk.selected == i;
        clicked => {
            Desk.select(i);
        }
        if f.custom-style: Text {
            text: @tr("Custom style");
            color: Theme.text2;
            font-size: 12px;
            vertical-alignment: center;
        }
        Glyph {
            text: Desk.selected == i ? "\u{E70E}" : "\u{E70D}";
            font-size: 10px;
        }
    }

    if Desk.selected >= 0: VerticalLayout {
        spacing: 4px;
        SectionLabel {
            text: @tr("Selected Bento");
        }

        Card {
            icon: "\u{E8AC}";
            title: @tr("Title");
            LineEdit {
                width: 260px;
                text <=> Desk.edit-title;
                accepted => {
                    Desk.rename();
                }
            }
            Button {
                text: @tr("Rename");
                clicked => {
                    Desk.rename();
                }
            }
        }

        Card {
            icon: "\u{E70E}";
            title: @tr("Roll up when docked");
            description: @tr("Roll up automatically when the Bento touches a screen edge.");
            Switch {
                checked <=> Desk.edit-auto-rollup;
                toggled => {
                    Desk.options-changed();
                }
            }
        }

        Card {
            icon: "\u{E890}";
            title: @tr("Stay visible during quick-hide");
            Switch {
                checked <=> Desk.edit-exempt;
                toggled => {
                    Desk.options-changed();
                }
            }
        }

        Card {
            icon: "\u{E790}";
            title: @tr("Appearance of this Bento");
            description: @tr("Color, transparency, title and corners.");
            Button {
                text: @tr("Customize");
                clicked => {
                    Desk.customize();
                }
            }
        }
    }
}

export component AppearancePage inherits ScrollPage {
    PageHeader {
        reset-page: 2;
        title: @tr("Appearance");
        subtitle: @tr("Changes are applied to the desktop at once.");
    }

    Card {
        icon: "\u{E8A9}";
        title: @tr("Apply to");
        description: @tr("The default style is used by every Bento without its own style.");
        ComboBox {
            width: 260px;
            model: Style.targets;
            current-index <=> Style.target;
            selected => {
                Style.target-changed();
            }
        }
    }

    if Style.target > 0: Card {
        icon: "\u{E777}";
        title: @tr("Use the default style");
        Switch {
            checked <=> Style.use-default;
            toggled => {
                Style.changed();
            }
        }
    }

    FencePreview {
        fill: Style.preview-fill;
        text-color: Style.preview-text;
        title-fill: Style.preview-title-fill;
        title: Style.preview-title;
        title-mode: Style.title-mode;
        title-size: Style.title-size * 1px;
        bold: Style.title-bold;
        font: Style.title-font;
        title-align: Style.title-align;
        radius: Style.corner-radius * 1px;
        border: Style.border;
        blur: Style.effect == 1;
    }

    if Style.target == 0 || !Style.use-default: VerticalLayout {
        spacing: 4px;
        SectionLabel {
            text: @tr("Color");
        }

        Panel {
            Text {
                text: @tr("Presets");
                color: Theme.text2;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                for c[i] in [#000000, #2b2f36, #1f3a5f, #0f4c4c, #2d4a22, #5a4214, #5c1f24, #3d2a5c, #e8e8e8]: Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: c;
                    border-width: pta.has-hover ? 2px : 1px;
                    border-color: pta.has-hover ? Theme.accent : Theme.divider;
                    pta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            Style.preset(i);
                        }
                    }
                }
            }
        }

        Panel {
            Text {
                text: @tr("Custom color");
                color: Theme.text2;
            }
            ColorPicker {
                hue <=> Style.hue;
                saturation <=> Style.saturation;
                lightness <=> Style.intensity;
                edited => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Transparency");
            Slider {
                width: 240px;
                minimum: 0;
                maximum: 100;
                value <=> Style.transparency;
                changed => {
                    Style.changed();
                }
            }
            SliderValue {
                text: round(Style.transparency) + " %";
            }
        }

        Card {
            icon: "\u{E727}";
            title: @tr("Background effect");
            description: @tr("Blur shows the wallpaper under the Bento, softened.");
            ComboBox {
                width: 200px;
                model: [@tr("Solid color"), @tr("Blur")];
                current-index <=> Style.effect;
                selected => {
                    Style.changed();
                }
            }
        }

        Card {
            icon: "\u{E790}";
            title: @tr("Chameleon");
            description: @tr("Adapt the color to the wallpaper under the Bento.");
            Switch {
                checked <=> Style.chameleon;
                toggled => {
                    Style.changed();
                }
            }
        }

        SectionLabel {
            text: @tr("Title");
        }

        Card {
            icon: "\u{E8C1}";
            title: @tr("Show the title");
            ComboBox {
                width: 200px;
                model: [@tr("Never"), @tr("On hover"), @tr("Always")];
                current-index <=> Style.title-mode;
                selected => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Font");
            FontPicker {
                fonts: Style.fonts;
                current-index: Style.font-index;
                value <=> Style.title-font;
                search(t) => {
                    Style.search-fonts(t);
                }
                picked => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Alignment");
            ComboBox {
                width: 200px;
                model: [@tr("Left"), @tr("Center"), @tr("Right")];
                current-index <=> Style.title-align;
                selected => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Size");
            Slider {
                width: 240px;
                minimum: 9;
                maximum: 24;
                value <=> Style.title-size;
                changed => {
                    Style.changed();
                }
            }
            SliderValue {
                text: round(Style.title-size) + " pt";
            }
        }

        Card {
            title: @tr("Bold");
            Switch {
                checked <=> Style.title-bold;
                toggled => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Title color");
            ComboBox {
                width: 200px;
                model: [@tr("Automatic"), @tr("White"), @tr("Black"), @tr("Custom")];
                current-index <=> Style.title-color;
                selected => {
                    Style.changed();
                }
            }
        }

        if Style.title-color == 3: Panel {
            ColorPicker {
                hue <=> Style.title-text-hue;
                saturation <=> Style.title-text-saturation;
                lightness <=> Style.title-text-lightness;
                edited => {
                    Style.changed();
                }
            }
        }

        Card {
            title: @tr("Title background");
            description: @tr("Automatic: the Bento color, slightly darkened.");
            ComboBox {
                width: 200px;
                model: [@tr("Automatic"), @tr("Custom")];
                current-index <=> Style.title-bg-mode;
                selected => {
                    Style.changed();
                }
            }
        }

        if Style.title-bg-mode == 1: Panel {
            ColorPicker {
                hue <=> Style.title-bg-hue;
                saturation <=> Style.title-bg-saturation;
                lightness <=> Style.title-bg-lightness;
                edited => {
                    Style.changed();
                }
            }
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Transparency");
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Slider {
                    width: 240px;
                    minimum: 0;
                    maximum: 100;
                    value <=> Style.title-bg-transparency;
                    changed => {
                        Style.changed();
                    }
                }
                SliderValue {
                    text: round(Style.title-bg-transparency) + " %";
                }
            }
        }

        SectionLabel {
            text: @tr("Shape");
        }

        Card {
            title: @tr("Corner radius");
            Slider {
                width: 240px;
                minimum: 0;
                maximum: 20;
                value <=> Style.corner-radius;
                changed => {
                    Style.changed();
                }
            }
            SliderValue {
                text: round(Style.corner-radius) + " px";
            }
        }

        Card {
            title: @tr("Border");
            Switch {
                checked <=> Style.border;
                toggled => {
                    Style.changed();
                }
            }
        }
    }

    HorizontalLayout {
        padding-top: 16px;
        spacing: 8px;
        alignment: start;
        Button {
            text: @tr("Apply this style to every Bento");
            clicked => {
                Style.apply-to-all();
            }
        }
        Button {
            text: @tr("Reset");
            clicked => {
                Style.reset();
            }
        }
    }

    SectionLabel {
        text: @tr("Windows");
    }

    Card {
        icon: "\u{E771}";
        title: @tr("Use the accent color");
        description: @tr("Highlights follow the Windows accent color.");
        Switch {
            checked <=> Cfg.use-accent-color;
            toggled => {
                Cfg.changed();
            }
        }
    }
}

export component LayoutPage inherits ScrollPage {
    PageHeader {
        reset-page: 3;
        title: @tr("Layout and magnetism");
        subtitle: @tr("How Bentos snap while they are moved or resized.");
    }

    Card {
        icon: "\u{E8A9}";
        title: @tr("Snap to screen edges");
        Switch {
            checked <=> Cfg.snap-to-edges;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{ECA5}";
        title: @tr("Snap to other Bentos");
        Switch {
            checked <=> Cfg.snap-to-fences;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Snap distance");
        Slider {
            width: 240px;
            minimum: 4;
            maximum: 40;
            value <=> Cfg.snap-distance;
            changed => {
                Cfg.changed();
            }
        }
        SliderValue {
            text: round(Cfg.snap-distance) + " px";
        }
    }

    Card {
        title: @tr("Gap between snapped Bentos");
        Slider {
            width: 240px;
            minimum: 0;
            maximum: 32;
            value <=> Cfg.snap-gap;
            changed => {
                Cfg.changed();
            }
        }
        SliderValue {
            text: round(Cfg.snap-gap) + " px";
        }
    }

    SectionLabel {
        text: @tr("Icons");
    }

    Card {
        icon: "\u{E80A}";
        title: @tr("Icon spacing in Bentos");
        description: @tr("Percentage of the desktop icon spacing.");
        Slider {
            width: 240px;
            minimum: 60;
            maximum: 200;
            value <=> Cfg.icon-spacing;
            changed => {
                Cfg.changed();
            }
        }
        SliderValue {
            text: round(Cfg.icon-spacing) + " %";
        }
    }
}

export component BehaviorPage inherits ScrollPage {
    PageHeader {
        reset-page: 4;
        title: @tr("Roll-up and quick-hide");
    }

    SectionLabel {
        text: @tr("Roll-up");
    }

    Card {
        icon: "\u{E70E}";
        title: @tr("Double-click the title to roll up");
        Switch {
            checked <=> Cfg.rollup-double-click;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Open a rolled-up Bento");
        description: @tr("The Bento opens until the mouse leaves it.");
        ComboBox {
            width: 200px;
            model: [@tr("On click"), @tr("On hover")];
            current-index <=> Cfg.rollup-open-on;
            selected => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Delay before rolling up again");
        description: @tr("Milliseconds after the mouse leaves an opened Bento, 0 = at once.");
        SpinBox {
            width: 140px;
            minimum: 0;
            maximum: 5000;
            step-size: 100;
            value <=> Cfg.rollup-collapse-delay;
            edited => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Roll up new docked Bentos");
        description: @tr("Default value for Bentos docked to a screen edge.");
        Switch {
            checked <=> Cfg.rollup-auto-docked;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Animate rolling up");
        description: @tr("The height changes smoothly. Off: the change is instant.");
        Switch {
            checked <=> Cfg.rollup-animate;
            toggled => {
                Cfg.changed();
            }
        }
    }

    SectionLabel {
        text: @tr("Quick-hide");
    }

    Card {
        title: @tr("Keep icons outside Bentos visible");
        Switch {
            checked <=> Cfg.qh-keep-free-icons;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Hide after inactivity");
        description: @tr("Seconds without desktop activity, 0 = never.");
        SpinBox {
            width: 140px;
            minimum: 0;
            maximum: 3600;
            step-size: 5;
            value <=> Cfg.qh-idle-seconds;
            edited => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E765}";
        title: @tr("Quick-hide shortcut");
        HotkeyField {
            value <=> Cfg.hk-quick-hide;
        }
    }
}

export component PagesPage inherits ScrollPage {
    PageHeader {
        reset-page: 5;
        title: @tr("Desktop pages");
        subtitle: @tr("Several sets of Bentos on the same desktop, one page at a time.");
    }

    Card {
        icon: "\u{E7C3}";
        title: @tr("Enable pages");
        Switch {
            checked <=> Cfg.pages-enabled;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Switch page at screen edges");
        description: @tr("Push the mouse against the left or right edge of the desktop.");
        Switch {
            checked <=> Cfg.pages-edge-switch;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        title: @tr("Show the page indicator");
        Switch {
            checked <=> Cfg.pages-indicator;
            toggled => {
                Cfg.changed();
            }
        }
    }

    Card {
        icon: "\u{E765}";
        title: @tr("Next page");
        HotkeyField {
            value <=> Cfg.hk-next-page;
        }
